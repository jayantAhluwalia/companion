# Copy to .env and fill in. Never commit .env.
PORT=8080
API_TOKEN=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Telegram (first client)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Leave empty on first run; the bot replies with your chat id, then set it here.
TELEGRAM_CHAT_ID=
DATABASE_URL=postgresql://...   # Supabase session pooler URI, password URL-encoded
# BOT_ENABLED=false               # for local runs, so the deployed bot keeps the Telegram token

# Nudge engine spend guards (optional; these are the defaults)
# MONTHLY_BUDGET_USD=18     # across everyone; everything stops above this. Each person also has their own ($4, owner $8)
# SCOUTS_PER_DAY=4          # web lookups per day across everyone (~$0.10-0.17 each); one per person per day

# Development (see `make dev`): a separate schema in the same database, and no real sends
# DB_SCHEMA=dev
# DRY_SEND=true
